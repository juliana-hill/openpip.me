# Google OAuth (create at console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Express-side upstreams (the browser uses same-origin relative requests)
AUTH_PROXY_URL=http://localhost:4001
BACKEND_URL=http://localhost:8000

# Express frontend origin used by the OAuth proxy after callback
FRONTEND_ORIGIN=http://localhost:4444
