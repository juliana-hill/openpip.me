# Google OAuth (create at console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Express-side upstreams (the browser uses same-origin relative requests)
AUTH_PROXY_URL=http://localhost:4001
BACKEND_URL=http://localhost:8000
# Auth-aware proxy target for /agent requests. The OAuth proxy must forward
# /agent/* to the Python backend (for local auth proxy: http://localhost:8000/agent).
AUTH_AGENT_UPSTREAM=http://localhost:4001

# Express frontend origin used by the OAuth proxy after callback
FRONTEND_ORIGIN=http://localhost:4444
