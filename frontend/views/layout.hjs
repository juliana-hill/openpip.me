<!doctype html>
<html lang="en" data-theme="system" data-accent="coral">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OpenPip</title>
    <link rel="icon" type="image/png" href="/trippy-transparent.png" />
    <link rel="apple-touch-icon" href="/trippy-transparent.png" />
    <script>
      (() => {
        // No localStorage anywhere: theme/accent and the assistant's
        // name/icon are Drive-backed only (user_settings.json), fetched
        // fresh by the React app on every load (see lib/theme.ts,
        // lib/agentIdentity.ts). Until that fetch resolves, this shell
        // shows the system light/dark preference and the static "coral" /
        // "OpenPip" defaults set above.
        const root = document.documentElement;
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        const applySystemTheme = () => {
          const isDark = media.matches;
          root.setAttribute("data-theme", isDark ? "dark" : "light");
          root.style.colorScheme = isDark ? "dark" : "light";
        };
        applySystemTheme();
        media.addEventListener("change", applySystemTheme);
      })();
    </script>
    <link rel="stylesheet" href="/styles/tokens.css" />
    <link rel="stylesheet" href="/styles/app-header.css" />
    <link rel="stylesheet" href="/styles/page-shell.css" />
    <link rel="stylesheet" href="/styles/card.css" />
    <link rel="stylesheet" href="/styles/express-adapter.css" />
  </head>
  <body>
    {{{body}}}
  </body>
</html>
