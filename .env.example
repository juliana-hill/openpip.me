# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://demo.openpip.me/auth/callback

# Session security (fallback OAuth proxy only)
SESSION_SIGNING_SECRET=

# AWS / Amazon Bedrock AgentCore
AWS_REGION=us-west-2
AGENTCORE_IDENTITY_PROVIDER_ID=
AGENTCORE_RUNTIME_ARN=

# Application URLs
FRONTEND_ORIGIN=http://localhost:4444
BACKEND_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000/api
OPENPIP_DATABASE_PATH=./data/openpip.sqlite3
OPENPIP_CORS_ORIGINS=http://localhost:4444,http://127.0.0.1:4444

# Optional service-to-service protection
INTERNAL_API_KEY=
