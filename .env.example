# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://demo.openpip.me/auth/callback

# Session security (fallback OAuth proxy only)
SESSION_SIGNING_SECRET=

# AWS / Amazon Bedrock AgentCore
AWS_REGION=us-west-2
AGENTCORE_IDENTITY_PROVIDER_ID=
AGENTCORE_RUNTIME_ARN=

# Application URLs
# OpenPip's own port range: 5500 (frontend) / 5501 (backend) — chosen to
# stay clear of every sibling project on this machine: travel-agent
# (4000-4003, 3097, 3099), career_discernment (3000), couchbumming (8000),
# dailies (8080). See docker-compose.yml for the containerized version of
# this, which uses service DNS names instead of localhost so no project's
# containers can ever cross-talk with another's.
FRONTEND_ORIGIN=http://localhost:5500
BACKEND_URL=http://localhost:5501
API_BASE_URL=http://localhost:5501/api
OPENPIP_DATABASE_PATH=./data/openpip.sqlite3
OPENPIP_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Path B (docs/OAUTH_SETUP.md) is implemented directly on this project's own
# FastAPI backend — /auth/login, /auth/callback, /auth/me, /auth/logout (see
# backend/src/openpip_backend/google_oauth.py). Never point this at
# travel-agent's proxy (http://localhost:4001) or any other project's port.
AUTH_PROXY_URL=http://localhost:5501
AUTH_AGENT_UPSTREAM=http://localhost:5501

# Optional service-to-service protection
INTERNAL_API_KEY=
